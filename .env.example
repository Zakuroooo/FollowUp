# Copy to .env.local for local development. On Vercel, add these under Settings → Environment Variables.

# Required — from Supabase → Project Settings → API (local values come from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never exposed to the browser
APP_URL=http://localhost:3200       # the live URL in production (used in email links and the form link)

# Optional — AI (paste-to-job, emergency triage, follow-up drafts). Without it, simple rules are used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_LIMIT=40                   # AI calls per business per day

# Optional — email (instant website-request alert + 7 AM call list). Without it, emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=FollowUp <onboarding@resend.dev>

# Required for the 7 AM email cron in production (any long random string; Vercel sends it automatically)
CRON_SECRET=

# Optional — device alerts (Web Push). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@followup.app
